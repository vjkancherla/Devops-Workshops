---

#--ElasticSearch--
es_cluster_name: elasticsearch_playground
es_node_name: "{{ ansible_hostname }}"
es_path_data: "/var/lib/elasticsearch"
es_path_logs: "/var/log/elasticsearch"
es_host: elasticsearch.project8.local
es_http_port: 9200
es_node_master: true
es_node_data: true
es_node_ingest: true

#--Kibana--
kibana_host: kibana.project8.local
kibana_port: 5601
elasticsearch_url: "http://{{ es_host }}:{{ es_http_port }}"

#--Filebeat--
os_syslog_path: "/var/log/*.log"
elasticsearch_log_path: "/var/log/elasticsearch/{{ es_cluster_name }}.log"
filebeat_log_path: "/var/log/filebeat/filebeat*"
metricbeat_log_path: "/var/log/metricbeat/metricbeat*"
kibana_log_path: "/var/log/kibana/kibana*"
grafana_log_path: "/var/log/grafana/grafana*"
prometheus_log_path: "/var/log/prometheus/*"
